# Copy to .env (git-ignored) and fill in. Never commit real values.

# OAuth token for Metrika and Webmaster
YANDEX_OAUTH_TOKEN=

# Default Metrika counter id (digits); several ids separated by commas are allowed
METRIKA_COUNTER_ID=

# Default Webmaster site: domain (example.com), URL, or host_id (https:example.com:443)
WEBMASTER_HOST=

# Wordstat (Yandex Cloud Search API)
YANDEX_WORDSTAT_API_KEY=
YANDEX_WORDSTAT_FOLDER_ID=
